doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Vehicles
        a(href="/update-cobj") Add to this table
        table 
            thead 
                tr 
                    th Name 
                    th Year 
                    th MPG 
            tbody 
                each vehicle in data
                    tr 
                        td= vehicle.properties.name
                        td= vehicle.properties.year
                        td= vehicle.properties.miles_per_gallon